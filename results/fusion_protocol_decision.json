{
  "version": "normalized_fusion[e+m]/rate/v2",
  "statistic": "rate",
  "channels": [
    "e",
    "m"
  ],
  "deferred_candidate_channels": [
    "c"
  ],
  "normalize_channels": true,
  "threshold_on": "fused_statistic",
  "fa_budget": 0.05,
  "protocol": "three_fold_holdout",
  "min_fit_episodes": 140,
  "min_scale_episodes": 40,
  "min_threshold_episodes": 80,
  "final_calibration_rule": "distribution_free_one_sided_tolerance_bound",
